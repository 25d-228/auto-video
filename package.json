{
  "name": "auto-video",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": "24.17.x",
    "npm": "11.13.x"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:ui": "vite",
    "lint": "oxlint . && cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test": "vitest run",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "build": "tsc -b && vite build",
    "build:native": "tauri build --no-bundle"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.16.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "oxlint": "1.76.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
