{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "auto-video",
  "version": "0.1.0",
  "identifier": "com.plushie.autovideo",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "auto-video",
        "width": 1040,
        "height": 880,
        "minWidth": 900,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../sidecar"]
  }
}
